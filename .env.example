# SQLite for local dev. To use Postgres, set provider = "postgresql" in
# prisma/schema.prisma and point this at your Postgres instance instead
# (see docker-compose.yml for a local one).
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"

# Seeded admin user (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"

# Bearer token an external scheduler must send to POST /api/cron/sync-all.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="replace-me"
